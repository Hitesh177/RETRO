# ─────────────────────────────────────────────────────────────────────────────
# ITG-SOFT — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — NEVER commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — get these from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only checkout settings. Never prefix secrets with VITE_.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# PAYPAL_CLIENT_ID=your-paypal-rest-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-rest-client-secret
# PAYPAL_WEBHOOK_ID=your-registered-paypal-webhook-id
# PAYPAL_ENV=sandbox
# SITE_URL=https://your-store-domain.example

# Optional public site URL used for canonical/OG generation
# VITE_SITE_URL=https://itg-soft.tw

# Optional webhook or edge-function endpoint for outbound notification events
# VITE_NOTIFICATIONS_ENDPOINT=https://your-function.example.com/notify
